                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Edit lock",
      "description": "5-minute lease: acquire, heartbeat every 2 minutes, release.",
      "item": [
        {
          "name": "Acquire",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/{{recipeId}}/lock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "{{recipeId}}",
                "lock"
              ]
            },
            "description": "201 {lockId, expiresAt}; saves `lockId`. 409 locked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.lockId !== undefined && body.lockId !== null) pm.collectionVariables.set('lockId', body.lockId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Heartbeat",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/{{recipeId}}/lock/{{lockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "{{recipeId}}",
                "lock",
                "{{lockId}}"
              ]
            },
            "description": "200; 409 lock_expired / locked."
          }
        },
        {
          "name": "Release",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/{{recipeId}}/lock/{{lockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "{{recipeId}}",
                "lock",
                "{{lockId}}"
              ]
            },
            "description": "204."
          }
        }
      ]
    },
    {
      "name": "Tags",
      "description": "Every catalog change answers with the whole catalog.",
      "item": [
        {
          "name": "Catalog",
