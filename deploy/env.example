# Copy to /srv/recipedealer/app/.env on the server (chmod 600). Never commit the real file.
# Values containing "$" (the bcrypt hash) must be in single quotes.

# Public IPv4 of the server (for app releases up to 1.1.0); the Caddyfile adds the domain itself.
SITE_ADDRESS=203.0.113.10
DB_PASSWORD=change-me-long-random

ADMIN_USERNAME=admin
# docker run --rm caddy:2.11.7 caddy hash-password --plaintext 'your-admin-password'
ADMIN_PASSWORD_HASH='$2a$14$replace.with.your.bcrypt.hash'

# Household registration code typed once when creating an account in the app (POST /v1/auth/register).
# Empty: registration is disabled; the admin still enrolls devices.
REGISTRATION_CODE=

# Optional household limits (defaults shown): users per household, households on the server (the default one
# included), recipe limit a new household starts with (the admin changes it per household).
#MAX_USERS=10
#MAX_HOUSEHOLDS=20
#DEFAULT_RECIPE_LIMIT=40
# Claude API costs a new household may cause per calendar month, in USD (the admin changes it per household).
#DEFAULT_LLM_BUDGET_USD=1.00

# Optional dead-man's switch pinged after each nightly dump (e.g. a healthchecks.io check URL).
DEADMAN_URL=

# Claude API key (console.anthropic.com → API keys) for LLM recipe extraction. Empty: LLM steps disabled.
ANTHROPIC_API_KEY=
# Optional dead-man's switch pinged after each successful daily API key check (06:00 server time), e.g. a second
# healthchecks.io check. It stays silent when the key is invalid or the account has no credit.
DEADMAN_API_KEY_URL=
