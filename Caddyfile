# Domains on the user's Cloudflare account, DNS only (proxy off), so Let's Encrypt reaches Caddy directly and Caddy
# gets and renews the certificates itself. api.recipedealer.com is the app's API (releases from 1.1.1);
# recipedealer.com is the website (www/) plus the admin dashboard; www.recipedealer.com redirects to it.
# The server's IP address is not served any more (releases up to 1.1.0 called https://2.31.66.200; dropped 2026-11-27).

(backend) {
	# Keep in sync with spring.servlet.multipart (25 MiB per file, 50 MiB per request; Spring "MB" means MiB); larger bodies get 413.
	request_body {
		max_size 50MiB
	}
	reverse_proxy app:8080
}

api.recipedealer.com {
	encode zstd gzip
	import backend
	log
}

# The website. The admin dashboard and its API are served here too (same origin: the browser keeps the admin login
# per host); the address bar keeps recipedealer.com. The app's API stays on api.recipedealer.com.
recipedealer.com {
	encode zstd gzip
	@backend path /admin /admin/* /v1/admin/*
	handle @backend {
		import backend
	}
	handle {
		root * /srv/www
		file_server
	}
	log
}

www.recipedealer.com {
	redir https://recipedealer.com{uri} permanent
}
