{
  "info": {
    "name": "RecipeDealer API v1",
    "description": "Generated from docs/api.md. Secrets (deviceToken, adminPassword, password, registrationCode) are empty: set them as current values in an environment or in the collection's Variables tab, and do not export them. Requests save ids (token, recipeId, lockId, headRevisionId, ...) into collection variables for the next request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{deviceToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Accounts",
      "description": "Registration and login need no token; both save the new token into `deviceToken`.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates a user with the first device. 201 Session; 403 registration_disabled / invalid_registration_code; 409 user_exists / user_limit_reached; 429 too_many_requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{password}}\",\n  \"deviceName\": \"{{deviceName}}\",\n  \"registrationCode\": \"{{registrationCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.token !== undefined && body.token !== null) pm.collectionVariables.set('deviceToken', body.token);",
                  "    if (body.userId !== undefined && body.userId !== null) pm.collectionVariables.set('userId', body.userId);",
                  "    if (body.deviceId !== undefined && body.deviceId !== null) pm.collectionVariables.set('deviceId', body.deviceId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "New token for an existing user; the same device name replaces that device's token. 201 Session; 401 invalid_credentials; 429 too_many_requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{password}}\",\n  \"deviceName\": \"{{deviceName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.token !== undefined && body.token !== null) pm.collectionVariables.set('deviceToken', body.token);",
                  "    if (body.userId !== undefined && body.userId !== null) pm.collectionVariables.set('userId', body.userId);",
                  "    if (body.deviceId !== undefined && body.deviceId !== null) pm.collectionVariables.set('deviceId', body.deviceId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Set or change password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me",
                "password"
              ]
            },
            "description": "currentPassword is required once the user has a password. 204; 403 invalid_credentials.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\",\n  \"currentPassword\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Captures",
      "description": "Uploading creates real data: on the production server a capture with a new URL and title becomes a new recipe by itself (auto-NEW). Delete it afterwards (Edit lock → Acquire, Recipes → Delete).",
      "item": [
        {
          "name": "Upload capture",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/captures/{{captureId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "captures",
                "{{captureId}}"
              ]
            },
            "description": "Multipart: part `capture` = capture JSON (capture-v1.json), one part per attachment named like `attachments[].name`. The pre-request script generates a new `captureId`. 201 stored, 200 already stored, 400 invalid_capture, 413 payload_too_large.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "capture",
                  "type": "text",
                  "contentType": "application/json",
                  "value": "{\n  \"schemaVersion\": 1,\n  \"captureId\": \"{{captureId}}\",\n  \"capturedAt\": \"2026-10-27T12:00:00Z\",\n  \"client\": {\n    \"appVersion\": \"1.0.0\",\n    \"androidSdk\": 36,\n    \"deviceModel\": \"Pixel 9\"\n  },\n  \"share\": {\n    \"action\": \"android.intent.action.SEND\",\n    \"mimeType\": \"text/plain\",\n    \"sourceApp\": \"com.android.chrome\",\n    \"subject\": \"Szarlotka – Kwestia Smaku\",\n    \"title\": null\n  },\n  \"source\": {\n    \"type\": \"WEB\",\n    \"url\": \"https://example.com/postman/{{captureId}}\",\n    \"siteName\": \"Kwestia Smaku\",\n    \"author\": null,\n    \"files\": []\n  },\n  \"recipe\": {\n    \"title\": \"Postman test {{captureId}}\",\n    \"language\": \"pl\",\n    \"servings\": {\n      \"text\": \"12 porcji\",\n      \"count\": 12\n    },\n    \"times\": {},\n    \"ingredientGroups\": [\n      {\n        \"name\": \"Jabłka\",\n        \"items\": [\n          \"1,5 kg jabłek\",\n          \"5 łyżek cukru\",\n          \"1/2 łyżeczki cynamonu\"\n        ]\n      },\n      {\n        \"name\": \"Ciasto\",\n        \"items\": [\n          \"320 g mąki (2 szklanki)\",\n          \"250 g zimnego masła*\",\n          \"1 jajko\"\n        ]\n      }\n    ],\n    \"stepGroups\": [\n      {\n        \"name\": \"Jabłka\",\n        \"items\": [\n          \"Jabłka obrać, pokroić na ćwiartki i wyciąć gniazda nasienne.\"\n        ]\n      },\n      {\n        \"name\": \"Pieczenie\",\n        \"items\": [\n          \"Piekarnik nagrzać do 180 stopni C.\",\n          \"Piec przez ok. 50 minut.\"\n        ]\n      }\n    ],\n    \"notes\": [\n      \"* masło można zastąpić margaryną.\"\n    ],\n    \"images\": []\n  },\n  \"completeness\": {\n    \"score\": 1.0,\n    \"hasTitle\": true,\n    \"hasIngredients\": true,\n    \"hasSteps\": true,\n    \"bestStage\": \"heuristic\"\n  },\n  \"provenance\": {\n    \"title\": \"heuristic\",\n    \"servings\": \"heuristic\",\n    \"ingredients\": \"heuristic\",\n    \"steps\": \"heuristic\",\n    \"notes\": \"heuristic\"\n  },\n  \"raw\": {\n    \"web\": {\n      \"finalUrl\": \"https://example.com/postman/{{captureId}}\",\n      \"canonicalUrl\": \"https://example.com/postman/{{captureId}}\",\n      \"title\": \"Szarlotka – Kwestia Smaku\",\n      \"lang\": \"pl\",\n      \"siteName\": \"Kwestia Smaku\",\n      \"ogImage\": \"https://www.kwestiasmaku.com/…/szarlotka-00_2.jpg\",\n      \"jsonLdRecipeId\": null,\n      \"botChallenge\": null,\n      \"stabilized\": false,\n      \"renderTimeMs\": 15000,\n      \"readableText\": \"Szarlotka … Składniki … Przygotowanie …\",\n      \"extractor\": {\n        \"…\": \"seed extractor output\"\n      }\n    }\n  },\n  \"attachments\": [],\n  \"diagnostics\": {\n    \"timingsMs\": {\n      \"stabilize\": 15000,\n      \"merge\": 2\n    },\n    \"errors\": [],\n    \"notes\": [\n      \"trigger=timeout\"\n    ]\n  }\n}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('captureId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.recipes && body.recipes[0] && body.recipes[0].recipeId !== undefined && body.recipes && body.recipes[0] && body.recipes[0].recipeId !== null) pm.collectionVariables.set('recipeId', body.recipes && body.recipes[0] && body.recipes[0].recipeId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Capture status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/captures/{{captureId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "captures",
                "{{captureId}}"
              ]
            },
            "description": "200 CaptureView; 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.recipes && body.recipes[0] && body.recipes[0].recipeId !== undefined && body.recipes && body.recipes[0] && body.recipes[0].recipeId !== null) pm.collectionVariables.set('recipeId', body.recipes && body.recipes[0] && body.recipes[0].recipeId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Inbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/captures?status=needs_decision,needs_attention",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "captures"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "needs_decision,needs_attention",
                  "disabled": false,
                  "description": "Comma-separated: accepted, processing, needs_decision, needs_attention, done"
                }
              ]
            },
            "description": "200 [CaptureView], at most 200, newest first."
          }
        },
        {
          "name": "Decide NEW",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/captures/{{captureId}}/extracted/0/resolution",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "captures",
                "{{captureId}}",
                "extracted",
                "0",
                "resolution"
              ]
            },
            "description": "Candidate index 0 becomes a new recipe; tags optional. 200 CaptureView; 409 already_resolved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"NEW\",\n  \"tags\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.recipes && body.recipes[0] && body.recipes[0].recipeId !== undefined && body.recipes && body.recipes[0] && body.recipes[0].recipeId !== null) pm.collectionVariables.set('recipeId', body.recipes && body.recipes[0] && body.recipes[0].recipeId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Decide UPDATE",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/captures/{{captureId}}/extracted/0/resolution",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "captures",
                "{{captureId}}",
                "extracted",
                "0",
                "resolution"
              ]
            },
            "description": "Candidate index 0 becomes a revision of `recipeId`. 409 already_resolved / recipe_gone.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"UPDATE\",\n  \"recipeId\": \"{{recipeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "description": "",
      "item": [
        {
          "name": "Candidates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/candidates?title=Szarlotka",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "candidates"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "Szarlotka",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "url",
                  "value": "",
                  "disabled": true,
                  "description": "Canonical URL"
                }
              ]
            },
            "description": "Possible matches: URL first, then similar titles."
          }
        },
        {
          "name": "Sync feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "disabled": false,
                  "description": "1–500"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}",
                  "disabled": true,
                  "description": "From the previous page"
                },
                {
                  "key": "updatedSince",
                  "value": "2026-10-01T00:00:00Z",
                  "disabled": true,
                  "description": "Only without a cursor"
                }
              ]
            },
            "description": "200 {items, nextCursor, hasMore}; saves `cursor`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.nextCursor !== undefined && body.nextCursor !== null) pm.collectionVariables.set('cursor', body.nextCursor);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/search?q=szarlotka",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "szarlotka",
                  "disabled": false,
                  "description": ""
                }
              ]
            },
            "description": "Titles and ingredients, typo tolerant; at most 30."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body[0] && body[0].recipeId !== undefined && body[0] && body[0].recipeId !== null) pm.collectionVariables.set('recipeId', body[0] && body[0].recipeId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Recipe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/{{recipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "{{recipeId}}"
              ]
            },
            "description": "200 RecipeView with ETag; saves `headRevisionId`. 410 recipe_deleted / recipe_merged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.headRevisionId !== undefined && body.headRevisionId !== null) pm.collectionVariables.set('headRevisionId', body.headRevisionId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Revisions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/{{recipeId}}/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "{{recipeId}}",
                "revisions"
              ]
            },
            "description": "All revisions, newest first."
          }
        },
        {
          "name": "Save edit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Lock-Id",
                "value": "{{lockId}}"
              },
              {
                "key": "If-Match",
                "value": "\"{{headRevisionId}}\""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/recipes/{{recipeId}}/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "recipes",
                "{{recipeId}}",
                "revisions"
              ]
            },
            "description": "Needs `Lock-Id` (Edit lock → Acquire) and `If-Match` (Recipe saves headRevisionId). 201 new head; 200 unchanged; 409 lock_required / lock_expired / locked; 412 head_changed; 428.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Szarlotka\",\n  \"language\": \"pl\",\n  \"servings\": {\n    \"text\": \"12 porcji\",\n    \"count\": 12\n  },\n  \"times\": {},\n  \"ingredientGroups\": [\n    {\n      \"name\": null,\n      \"items\": [\n        \"1,5 kg jabłek\",\n        \"320 g mąki\"\n      ]\n    }\n  ],\n  \"stepGroups\": [\n    {\n      \"name\": null,\n      \"items\": [\n        \"Jabłka obrać.\",\n        \"Piec 50 minut w 180 °C.\"\n      ]\n    }\n  ],\n  \"notes\": [],\n  \"images\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300 && pm.response.text()) {",
                  "    const body = pm.response.json();",
                  "    if (body.headRevisionId !== undefined && body.headRevisionId !== null) pm.collectionVariables.set('headRevisionId', body.headRevisionId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
