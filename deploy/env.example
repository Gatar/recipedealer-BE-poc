# Copy to /srv/recipedealer/app/.env on the server (chmod 600). Never commit the real file.
# Values containing "$" (the bcrypt hash) must be in single quotes.

# Public IPv4 of the server now; a domain name later.
SITE_ADDRESS=203.0.113.10
DB_PASSWORD=change-me-long-random

ADMIN_USERNAME=admin
# docker run --rm caddy:2.11.7 caddy hash-password --plaintext 'your-admin-password'
ADMIN_PASSWORD_HASH='$2a$14$replace.with.your.bcrypt.hash'

# Household registration code typed once when creating an account in the app (POST /v1/auth/register).
# Empty: registration is disabled; the admin still enrolls devices.
REGISTRATION_CODE=

# Optional dead-man's switch pinged after each nightly dump (e.g. a healthchecks.io check URL).
DEADMAN_URL=
